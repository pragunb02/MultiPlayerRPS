# Copy to .env and fill in. Never commit .env.

# MongoDB connection string. Use a local/dev database for development — never production.
# (MONGO_URI_PRODUCTION is still accepted as a fallback for existing deployments.)
MONGO_URI=mongodb://localhost:27017/classicade

# Long random string used to sign session cookies, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Optional
PORT=8080
NODE_ENV=development
