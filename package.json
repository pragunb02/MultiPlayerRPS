{
  "name": "classicade",
  "version": "0.1.0",
  "private": true,
  "description": "ClassiCade \u2014 real-time multiplayer classic games",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "start": "node apps/server/src/index.js",
    "dev:server": "npm run dev -w @classicade/server",
    "start:server": "npm start -w @classicade/server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:web": "npm run dev -w @classicade/web",
    "build:web": "npm run build -w @classicade/web",
    "test:e2e": "npm test -w @classicade/e2e"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  }
}
