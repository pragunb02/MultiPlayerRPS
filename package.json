{
  "name": "classicade",
  "version": "0.1.0",
  "private": true,
  "description": "ClassiCade — real-time multiplayer classic games",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "start": "node apps/server/src/index.js",
    "dev:server": "npm run dev -w @classicade/server",
    "start:server": "npm start -w @classicade/server",
    "lint": "eslint . && node scripts/check-comments.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --tags-filter=\"not slow\"",
    "test:watch": "vitest --tags-filter=\"not slow\"",
    "test:coverage": "vitest run --coverage --tags-filter=\"not slow\"",
    "test:all": "vitest run --coverage",
    "dev:web": "npm run dev -w @classicade/web",
    "build:web": "npm run build -w @classicade/web",
    "test:e2e": "npm test -w @classicade/e2e",
    "test:visual": "node scripts/bin/visual.mjs",
    "test:visual:update": "node scripts/bin/visual.mjs --update"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "espree": "^11.2.0",
    "globals": "^17.13.0",
    "mongodb": "^7.7.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  }
}
