# Server (apps/server). Copy to apps/server/.env for `npm run dev:server`.

# development | test | production
NODE_ENV=development

# Default 4000 (the web dev server proxies to it).
PORT=4000

# The address the server listens on (CC-287). Default 127.0.0.1: this machine only, so the dev server and its
# session cookie are never offered to the rest of your network. Must be an IP address or a hostname, or the boot
# fails. Render sets 0.0.0.0 (its proxy must reach the server), and so does the Docker image.
# HOST=127.0.0.1

# fatal | error | warn | info | debug | trace | silent (default: info; silent when NODE_ENV=test)
LOG_LEVEL=info

# Required. Use a local/dev database — never production.
MONGO_URI=mongodb://localhost:27017/classicade-dev

# Required, at least 32 characters: `openssl rand -hex 32`
SESSION_SECRET=

# Browser origins allowed to open realtime connections (comma-separated). Required in production.
# Default outside production: http://localhost:4000,http://localhost:5173
# ALLOWED_ORIGINS=https://classicade.app

# Serve the built web app from this server (single deploy). Build it first: npm run build:web
# Required in production; relative paths are resolved from the working directory.
# WEB_DIST_DIR=../web/dist

# How many proxies in front of the server add to X-Forwarded-For. Rate limits key on the client address found that
# many entries in from the right. Default 1 in production (at least 1 there) and 0 elsewhere. See docs/DEPLOYMENT.md.
# TRUST_PROXY_HOPS=1

# Account ids that may open the owner console at /admin, comma separated (CC-233). Empty means nobody.
# Your id is identity.id at /api/session while you are logged in. See docs/DEPLOYMENT.md.
# ADMIN_ACCOUNT_IDS=user_65f0c2a1b2c3d4e5f6a7b8c9

# Operations telemetry (ADR-055, docs/DEPLOYMENT.md). Off while the endpoint is empty: no OpenTelemetry code loads.
# Both are set in Render only. The headers hold a token: never commit a value. For a collector on this machine,
# http://127.0.0.1:4318 works outside production (production needs https://).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SDK_DISABLED=true          # off, keeping the two above
# OTEL_LOGS_EXPORTER=none         # metrics only
# OTEL_METRIC_EXPORT_INTERVAL=60000
